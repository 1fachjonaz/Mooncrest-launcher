{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mooncrest Launcher",
  "version": "1.0.0",
  "identifier": "group.mooncrest.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Mooncrest Launcher",
        "width": 1280,
        "height": 780,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "center": true,
        "backgroundColor": "#101522"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Mooncrest Group",
    "copyright": "© 2026 Mooncrest Group",
    "category": "Utility",
    "shortDescription": "Mooncrest Launcher",
    "longDescription": "Install, update and start Mooncrest Group products.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
