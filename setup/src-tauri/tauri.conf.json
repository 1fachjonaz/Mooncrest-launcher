{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mooncrest Launcher Setup",
  "version": "1.0.0",
  "identifier": "group.mooncrest.setup",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'",
      "freezePrototype": true
    }
  },
  "bundle": { "active": false, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"] }
}
